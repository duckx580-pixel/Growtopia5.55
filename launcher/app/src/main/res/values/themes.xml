<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PremiumLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/light_accent</item>
        <item name="colorPrimaryDark">@color/light_accent</item>
        <item name="colorAccent">@color/light_accent</item>
        <item name="android:windowBackground">@color/light_background</item>
    </style>

    <style name="Theme.PremiumLauncher.Light" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/light_accent</item>
        <item name="colorPrimaryDark">@color/light_accent</item>
        <item name="colorAccent">@color/light_accent</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_on_surface</item>
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:textColorPrimary">@color/light_on_surface</item>
    </style>

    <style name="Theme.PremiumLauncher.DarkMode" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorPrimaryDark">@color/dark_accent</item>
        <item name="colorAccent">@color/dark_accent</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:textColorPrimary">@color/dark_on_surface</item>
    </style>

    <style name="Theme.PremiumLauncher.PremiumMode" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/premium_gradient_start</item>
        <item name="colorPrimaryDark">@color/premium_background</item>
        <item name="colorAccent">@color/premium_lightning</item>
        <item name="colorSurface">@color/premium_surface</item>
        <item name="colorOnSurface">@color/premium_on_surface</item>
        <item name="android:windowBackground">@color/premium_background</item>
        <item name="android:textColorPrimary">@color/premium_on_surface</item>
    </style>

</resources>
