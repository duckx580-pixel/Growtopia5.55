<?xml version="1.0" encoding="utf-8"?>
<!-- Double-stroke premium frame: darker outer gold ring, lighter inner
     hairline, for a subtle embossed border on cards/panels. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/gold_dark" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/gold_light" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
